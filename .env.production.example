# Production Environment Template
# Copy to .env and fill in values

# Database (Provided by hosting platform)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# OR individual values
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=hallhub

# Application
PORT=3000
NODE_ENV=production

# JWT (Generate a strong secret for production)
JWT_SECRET=generate-a-strong-secret-key-min-32-chars
JWT_EXPIRATION=7d
